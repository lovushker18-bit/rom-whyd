{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "music-rating-site",
  "main": "src/index.js",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "music-rating-db",
      "database_id": "PUT_YOUR_D1_DATABASE_ID_HERE"
    }
  ]
}
